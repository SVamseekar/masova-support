# MaSoVa Agent environment template
# Copy to repo-root .env and fill in real values. Never commit .env.
# Canonical copy: config/env.example (keep these two files in sync).

# --- LLM (Google ADK / Gemini) ---
# Prefer LLM_* names; GOOGLE_API_KEY still works as fallback
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.5-flash
OPS_LLM_MODEL=gemini-2.5-flash
OPS_PREFER_LLM=
GOOGLE_API_KEY=your_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=0

# Ops tool-loop budgets
OPS_MAX_TOOL_CALLS=12
OPS_LLM_TIMEOUT_SEC=45
OPS_CONTEXT_CHARS=8000

# --- Customer chat JWT (must match MaSoVa core-service HS512) ---
JWT_SECRET=change-me-same-as-backend-hs512-secret

# --- Inbound ops triggers (scheduler / internal) ---
# Header: X-Agent-Api-Key
AGENT_TRIGGER_API_KEY=change-me-service-to-service-key

# --- Outbound to MaSoVa platform backend ---
BACKEND_URL=http://localhost:8080
AGENT_TOKEN=change-me-backend-service-token

# --- Sessions / events ---
REDIS_URL=redis://localhost:6379/1
REDIS_HOST=
REDIS_PORT=6379
REDIS_IDEMPOTENCY_DB=2
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- Proposals (local durable JSONL) ---
PROPOSAL_DATA_DIR=

# --- HTTP / process ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO
LOG_FILE=
