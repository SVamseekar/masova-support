# Chat-completions LLM provider — required by both the support chat agent
# and the review-response agent. LLM_MODEL is a litellm model string
# (provider/model-id); see litellm provider docs for available model IDs.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Backend (api-gateway)
BACKEND_URL=http://192.168.50.88:8080

# JWT secret — MUST match the backend's JWT_SECRET exactly. Used to verify
# customer-presented bearer tokens on POST /agent/chat locally (HS512),
# without a network round-trip.
JWT_SECRET=

# Static service API key for internal /agents/{name}/trigger endpoints.
# Not tied to a customer identity — used by schedulers/ops tooling only.
AGENT_TRIGGER_API_KEY=

# Redis / RabbitMQ
REDIS_URL=redis://192.168.50.88:6379/1
RABBITMQ_URL=amqp://guest:guest@192.168.50.88:5672/

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
